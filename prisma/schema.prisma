// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ADMIN USER
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  ADMIN
  EDITOR
}

// NYHETER (News)
model News {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  seoTitle        String?
  metaDescription String?
  featuredImage   String?
  excerpt         String?   @db.Text
  content         String    @db.Text
  author          String?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
}

// PRODUKTER (Products)
model Product {
  id                    String    @id @default(cuid())
  slug                  String    @unique
  artNr                 String?
  title                 String    // Benämning
  ean                   String?
  countPerBag           String?   // Antal/påse
  weightPerBag          String?   // Vikt/påse
  description           String?   @db.Text
  productInfo           String?   @db.Text // Produktinformation
  nutritionInfo         String?   @db.Text // Näringsvärde
  ingredients           String?   @db.Text // Innehållsförteckning
  storage               String?   @db.Text // Förvaring
  cookingInstructions   String?   @db.Text // Tillagningsanvisningar
  featuredImage         String?
  published             Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([slug])
}

// RECEPT (Recipes)
model Recipe {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String?   @db.Text
  ingredients     String?   @db.Text // Can be HTML or structured JSON, keeping Text for flexibility
  instructions    String?   @db.Text
  prepTime        String?
  featuredImage   String?
  published       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
}

// BUTIKER / HITTA OSS (Stores)
model Store {
  id              String    @id @default(cuid())
  name            String
  address         String?
  lat             Float?
  lng             Float?
  googlePlaceId   String?
  published       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
